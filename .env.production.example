# 复制为 .env.production 后填写；该文件仅作示例，不包含真实凭据。
NODE_ENV=production
PORT=3000
BLOG_HOSTNAME=127.0.0.1
# 留空时启动脚本自动使用当前项目根目录下的 data/blog.db。
DATABASE_PATH=
# 运行指南中的随机令牌生成命令，并将此占位值替换为生成的值。
ADMIN_SETUP_TOKEN=CHANGE_ME_TO_A_RANDOM_TOKEN
# 留空则在私有数据库中自动生成并保存。
SESSION_SECRET=
# 仅搭配文档中覆盖 Host/Proto/IP 的可信 Nginx 反代使用。
TRUST_PROXY=1
